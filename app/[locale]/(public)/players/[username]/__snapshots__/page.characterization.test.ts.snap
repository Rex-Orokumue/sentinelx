exports[`player profile page — characterization (pins current behavior; must not change during extraction) > signed-in visitor who follows the target > queries 1`] = `
[
  "profiles:select|eq(username)",
  "friends:select|or",
  "player_follows:select|eq(follower_id)|eq(following_id)",
  "player_follows:select|eq(follower_id)|eq(following_id)",
  "squad_members:select|eq(player_id)",
  "rpc:player_rank",
  "player_follows:select|eq(following_id)",
  "player_follows:select|eq(follower_id)",
  "matches:select|eq(status)|or",
  "matches:select|eq(round)|eq(status)|or",
  "matches:select|eq(status)|or",
  "tournament_registrations:select|eq(player_id)|eq(payment_status)",
  "profiles:select|gte(total_matches)",
  "achievements:select",
  "player_achievements:select|eq(player_id)",
  "player_store_items:select|eq(player_id)|eq(equipped)",
  "player_achievements:select",
  "community_posts:select|eq(author_id)|eq(is_deleted)",
  "community_posts:select|eq(author_id)|eq(is_deleted)|not(image_url)",
  "squad_members:select|in(squad_id)",
  "seasons:select|eq(status)",
  "games:select|eq(slug)",
]
`;

