exports[`player profile page — characterization (pins current behavior; must not change during extraction) > owner sees the owner-only coin balance and season standing > adminQueries 1`] = `
[
  "sx_coins:select|eq(player_id)",
  "tournaments:select|eq(season_id)|eq(game_id)|in(tournament_type)",
  "matches:select|in(tournament_id)",
  "tournament_registrations:select|in(tournament_id)|eq(status)",
  "season_ranking_points:select|eq(season_id)|in(tournament_id)",
  "profiles:select|in(id)",
  "tournaments:select|eq(season_id)|eq(game_id)|eq(tournament_type)|gte(tournament_start)|lt(tournament_start)",
]
`;

